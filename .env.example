# SIP AI Client — переменные окружения
# Можно использовать вместо config.yaml

# LLM провайдер: ollama, openai, cloud_api
SIP_AI_LLM_PROVIDER=ollama

# SIP настройки
SIP_AI_SIP__SERVER=127.0.0.1
SIP_AI_SIP__PORT=5060
SIP_AI_SIP__USERNAME=1001
SIP_AI_SIP__PASSWORD=secret

# Whisper
SIP_AI_WHISPER__MODEL_SIZE=large-v3
SIP_AI_WHISPER__LANGUAGE=ru
SIP_AI_WHISPER__DEVICE=cpu

# Piper TTS
SIP_AI_PIPER__VOICE=ru_RU-ruslan-medium

# Ollama
SIP_AI_OLLAMA__HOST=http://localhost:11434
SIP_AI_OLLAMA__MODEL=llama3.1:70b

# Cloud API (если llm_provider=openai/cloud_api)
SIP_AI_CLOUD_API__API_KEY=sk-your-api-key-here
SIP_AI_CLOUD_API__MODEL=gpt-4o
# SIP_AI_CLOUD_API__API_BASE=https://api.openai.com/v1
